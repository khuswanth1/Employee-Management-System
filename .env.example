# Used by docker-compose.yml / docker-compose.prod.yml. Copy to .env and fill in; never commit .env.
# Use letters and digits only in the three DB passwords (they are interpolated into URLs and SQL).
POSTGRES_PASSWORD=
PLATFORM_DB_PASSWORD=
PROVISIONER_DB_PASSWORD=

# Backend secrets. Generate:
#   SECRET_KEY:      python -c "import secrets;print(secrets.token_urlsafe(48))"
#   ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Losing ENCRYPTION_KEY makes every tenant database URL unrecoverable - back it up separately.
SECRET_KEY=
ENCRYPTION_KEY=

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Public origin of the app (CORS), e.g. https://worksphere.example.com
PUBLIC_ORIGIN=http://localhost:5173

# Shared Redis used by docker-compose.prod.yml (rate limits, live events, job lock)
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# WebRTC relay (optional but needed for users behind strict NATs)
# Generate TURN_SECRET: python -c "import secrets;print(secrets.token_urlsafe(32))"
# TURN_URL e.g. turn:turn.example.com:3478 (dev: turn:localhost:3478); TURN_EXTERNAL_IP = server's public IP
TURN_URL=
TURN_SECRET=
TURN_EXTERNAL_IP=
TURN_REALM=worksphere

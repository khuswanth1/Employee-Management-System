# Copy to .env and fill in. NEVER commit real values.
ENVIRONMENT=development
# >=32 chars, random. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

PLATFORM_DATABASE_URL=sqlite:///./data/platform.db
# sqlite (local dev/tests) or postgres (production)
TENANT_DB_MODE=sqlite
TENANT_SQLITE_DIR=./data/tenants
# postgres mode only: connection with CREATEDB + CREATEROLE, used ONLY for provisioning
POSTGRES_ADMIN_URL=
TENANT_DB_HOST=db
TENANT_DB_PORT=5432

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
# Optional shared Redis for several backend instances (rate limits, live events, job lock). Leave empty for one instance.
# REDIS_URL=redis://:PASSWORD@redis:6379/0
# Origin used in e-mailed links (password reset, e-mail verification)
APP_BASE_URL=http://localhost:5173

# First platform admin, created at startup if no platform user exists
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
WEBHOOK_ALLOW_PRIVATE_URLS=false
WEBHOOK_WORKER_INTERVAL_SECONDS=5

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# WebRTC
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Preferred: shared secret from coturn "static-auth-secret"; the API issues 1-hour credentials
TURN_SECRET=
